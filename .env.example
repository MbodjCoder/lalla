# ── Base de données (docker compose up -d) ──────────────────────────
DATABASE_URL="postgresql://lalla:lalla@localhost:5436/lalla"

# ── Moteur IA ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# Modèle de conversation (défaut : claude-sonnet-5-5)
LALLA_MODELE_IA="claude-sonnet-5-5"

# ── Gemini (Google AI Studio), utilisé si ANTHROPIC_API_KEY est vide ──
# Clé gratuite : aistudio.google.com/apikey
GEMINI_API_KEY=""
# Cascade de modèles, du meilleur au plus modeste (chacun a son quota gratuit quotidien)
LALLA_MODELES_GEMINI="gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite"
# Pour imposer un fournisseur quand les deux clés sont présentes : anthropic | gemini
# LALLA_FOURNISSEUR=""

# ── Embeddings RAG (Voyage AI, multilingue). Vide = recherche plein texte.
VOYAGE_API_KEY=""

# ── WhatsApp Cloud API (Meta). Vide = mode console (messages journalisés).
WHATSAPP_JETON=""
WHATSAPP_ID_NUMERO=""
# Modèle de message approuvé par Meta pour les notifications sortantes
WHATSAPP_MODELE_NOTIFICATION="lalla_nouvelle_demande"

# ── Application ─────────────────────────────────────────────────────
URL_PUBLIQUE="http://localhost:3000"
# Secret de signature des sessions personnel (32+ caractères aléatoires)
SECRET_SESSION="changez-moi-par-une-longue-chaine-aleatoire-de-32-caracteres"
