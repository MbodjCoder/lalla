{
  "name": "lalla",
  "version": "0.1.0",
  "private": true,
  "description": "Lalla — concierge IA de chambre d'hôtel accessible par QR code",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "bdd:demarrer": "docker compose up -d",
    "bdd:migrer": "prisma migrate dev",
    "bdd:deployer": "prisma migrate deploy",
    "bdd:semer": "tsx prisma/semence.ts",
    "bdd:studio": "prisma studio",
    "rag:indexer": "tsx scripts/indexer-documents.ts",
    "carte:photos": "tsx scripts/completer-photos.ts",
    "lalla:tester": "tsx scripts/tester-conversation.ts",
    "lalla:voie-rapide": "tsx --conditions=react-server scripts/tester-voie-rapide.ts",
    "lalla:longue-conversation": "tsx --conditions=react-server scripts/tester-longue-conversation.ts",
    "lalla:question-reception": "tsx --conditions=react-server scripts/tester-question-reception.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "jose": "^6.2.12",
    "lucide-react": "^1.56.0",
    "nanoid": "^6.0.2",
    "next": "16.2.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
